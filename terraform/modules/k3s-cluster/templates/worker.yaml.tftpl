#cloud-config
hostname: ${hostname}
package_update: true
packages:
  - qemu-guest-agent
  - curl
  - ca-certificates
users:
  - name: ubuntu
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}
runcmd:
  - systemctl enable qemu-guest-agent
  - systemctl start qemu-guest-agent
  - |
    for attempt in $(seq 1 60); do
      curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION='${k3s_version}' K3S_URL='https://${server_ip}:6443' K3S_TOKEN='${token}' sh - && exit 0
      sleep 10
    done
    exit 1
