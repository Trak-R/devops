#!/bin/bash
# Grow the root filesystem, then create the OpenEBS volume group on a blank
# data disk. The data disk is selected by virtio serial. This script never
# wipes, partitions, or removes an existing signature.
set -euo pipefail

byid='/dev/disk/by-id/virtio-${data_disk_serial}'
vg='${data_volume_group}'
enabled='${data_disk_enabled}'

grow_root() {
  local source fstype parent part rc
  source=$(findmnt -n -o SOURCE /)
  fstype=$(findmnt -n -o FSTYPE /)
  case "$source" in
    /dev/*)
      parent=$(lsblk -ndo PKNAME "$source" 2>/dev/null || true)
      part=$(lsblk -ndo PARTN "$source" 2>/dev/null || true)
      if [ -n "$parent" ] && [ -n "$part" ]; then
        set +e
        growpart "/dev/$parent" "$part"
        rc=$?
        set -e
        if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
          echo "growpart /dev/$parent $part failed with status $rc" >&2
          exit "$rc"
        fi
      fi
      ;;
  esac
  case "$fstype" in
    ext2|ext3|ext4) resize2fs "$source" ;;
    xfs) xfs_growfs / ;;
  esac
}

grow_root

if [ "$enabled" != "true" ]; then
  exit 0
fi

for _ in $(seq 1 30); do
  if [ -e "$byid" ]; then
    break
  fi
  sleep 1
done

if [ ! -e "$byid" ]; then
  echo "data disk $byid is not attached; leaving persistent storage uninitialized"
  exit 0
fi

dev=$(readlink -f "$byid")
data_name=$(lsblk -ndo KNAME "$dev")
root_source=$(findmnt -n -o SOURCE /)
root_name=$(lsblk -ndo PKNAME "$root_source" 2>/dev/null || true)
if [ -z "$root_name" ]; then
  root_name=$(lsblk -ndo KNAME "$root_source")
fi
if [ "$data_name" = "$root_name" ]; then
  echo "refusing to initialize $dev because it is the root disk" >&2
  exit 1
fi

current_vg=$(pvs --noheadings -o vg_name "$dev" 2>/dev/null | awk '{print $1}' || true)
if [ "$current_vg" = "$vg" ]; then
  exit 0
fi
if [ -n "$current_vg" ]; then
  echo "data disk $dev belongs to volume group $current_vg; leaving it unchanged"
  exit 0
fi
if vgs --noheadings -o vg_name 2>/dev/null | awk '{print $1}' | grep -qx "$vg"; then
  echo "volume group $vg already exists without $dev; leaving the disk unchanged"
  exit 0
fi
if [ -n "$(wipefs -n "$dev")" ]; then
  echo "data disk $dev already has a signature; leaving it unchanged"
  exit 0
fi

pvcreate "$dev"
vgcreate "$vg" "$dev"
