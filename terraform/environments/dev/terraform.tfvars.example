# Copy to terraform.tfvars. That file is gitignored.
# Export the API token before plan or apply. Do not put it in this file.
#
#   export PROXMOX_VE_API_TOKEN="terraform@pve!trakr=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

proxmox_endpoint  = "https://proxmox.example.com:8006/"
proxmox_insecure  = true
proxmox_node_name = "pve"

datastore_id         = "local-lvm"
image_datastore_id   = "local"
snippet_datastore_id = "local"
bridge               = "vmbr0"

gateway               = "192.168.1.1"
control_plane_address = "192.168.1.40/24"
worker_addresses      = ["192.168.1.41/24", "192.168.1.42/24"]
ssh_public_key        = "ssh-ed25519 AAAA... you@host"
